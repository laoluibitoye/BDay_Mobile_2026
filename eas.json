{
  "cli": {
    "version": ">= 22.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "standalone-test": {
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6748347942",
        "appleTeamId": "FU9T32FCB5"
      }
    }
  }
}
