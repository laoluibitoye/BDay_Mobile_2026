{
  "expo": {
    "name": "BusinessDay",
    "slug": "app",
    "scheme": "businessday",
    "owner": "businessday-technology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/bd-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bdnews.businessday.bdtech",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "bdnews.businessday.bdtech",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FA",
        "foregroundImage": "./assets/brand/bd-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/bd-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/bd-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/bd-icon.png",
          "color": "#F8F9FA"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "extra": {
      "eas": {
        "projectId": "828b4896-f29b-4401-a259-9bea46bffc30"
      }
    }
  }
}
